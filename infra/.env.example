# Configuration contract for app/config.py. Copy to infra/.env and fill in secrets.
# Every Settings field is listed. Lines starting with "# KEY=" show a default you can
# usually leave alone. tests/test_config.py fails if this file and Settings drift apart.
# Leave a value empty only without an inline comment: dotenv keeps the comment as the value.

# --- App ---
ENVIRONMENT=dev           # dev | prod (prod hides 5xx error details)
LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR

# --- Vector store (Qdrant >= 1.16) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_chunks
# Blank for local Qdrant; required for Qdrant Cloud.
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=60
# Points per upsert request (~20 KB each); lower it if ingest uploads time out.
# QDRANT_UPSERT_BATCH_SIZE=16
# Changing a vector name requires recreating the collection and re-ingesting.
# QDRANT_DENSE_VECTOR_NAME=dense
# QDRANT_SPARSE_VECTOR_NAME=bm25

# --- Embedding model ---
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSION=768   # must match the model: bge-base 768, bge-large 1024
# EMBEDDING_MAX_TOKENS=512
# EMBEDDING_QUERY_INSTRUCTION=Represent this sentence for searching relevant passages:

# --- Reranker model ---
RERANKER_MODEL=BAAI/bge-reranker-base
# RERANK_BATCH_SIZE=16

# --- LLM (see docs/adr/0001-gemini-default-provider-abstraction.md) ---
# Roles: generation = cited answers; fast = follow-up rewrite + retrieval grading;
# judge = eval scoring. Providers: gemini | groq | anthropic | ollama.
# List model ids your key can use: python -m app.llm.list_models (stable ids only, no preview).
LLM_PROVIDER=gemini
LLM_GENERATION_MODEL=gemini-3.8-flash
LLM_FAST_MODEL=gemini-3.5-flash-lite
# Reasoning depth per role: minimal | low | medium | high (blank = model default).
# LLM_GENERATION_THINKING=low
# LLM_FAST_THINKING=minimal
# Judge on another model family than the generator (less self-preference bias).
# Groq model ids: https://console.groq.com/docs/models
LLM_JUDGE_PROVIDER=groq
LLM_JUDGE_MODEL=openai/gpt-oss-120b
# LLM_JUDGE_THINKING=low
# After retries, generation and fast switch to this provider on 429 / timeout / 5xx.
# Blank = no fallback.
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_MODEL=openai/gpt-oss-120b
# Keys: the primary's and the fallback's are required at startup; the judge's only for --judge.
GEMINI_API_KEY=your-gemini-key
GROQ_API_KEY=gsk_your-key-here
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# Only if a role uses LLM_*_PROVIDER=anthropic:
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# Ollama (private mode, nothing leaves the machine): LLM_PROVIDER=ollama + model names.
# OLLAMA_BASE_URL=http://localhost:11434
LLM_MAX_TOKENS=2048
# Blank = provider default (recommended for Gemini 3 and Claude 5 models).
LLM_TEMPERATURE=
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2
# Client-side limits per model of the primary provider (0 = off). Set them to your quota
# (AI Studio > rate limits) so calls queue instead of failing with 429.
LLM_RPM_LIMIT=10
LLM_TPM_LIMIT=250000
# The same for the fallback and judge providers (Groq free tier: console.groq.com > limits).
LLM_FALLBACK_RPM_LIMIT=30
LLM_FALLBACK_TPM_LIMIT=8000
# LLM_REWRITE_MAX_TOKENS=200
# LLM_GRADER_MAX_TOKENS=300
# Template set in app/prompts/templates/<version>/; part of the cache key.
# v2 = per-excerpt grading + search-query rewrite after an ambiguous grade.
# PROMPT_VERSION=v2

# --- Redis (sessions + semantic cache answers) ---
REDIS_URL=redis://localhost:6379
REDIS_TTL_SECONDS=3600    # conversation session expiry
# CONVERSATION_MAX_TURNS=6

# --- Retrieval ---
# hybrid = dense + BM25 fused with RRF; dense / sparse = one branch alone (for eval ablations).
# RETRIEVAL_MODE=hybrid
RETRIEVAL_TOP_K=20        # fused candidates fetched before reranking
RERANK_TOP_K=5            # chunks passed to the LLM after reranking
# RRF_K=60
# Top rerank score below which retrieval grades "none" without an LLM call; tune with
# `python -m evaluation.grader_labels score --set grade_min_rerank_score=...`.
# GRADE_MIN_RERANK_SCORE=0.005
# Search-query rewrites + re-retrievals after an "ambiguous" grade; 2 fast-model calls each (0 = off).
# GRADER_MAX_RETRIES=1

# --- Semantic cache (question embeddings in Qdrant, answers in Redis) ---
# SEMANTIC_CACHE_ENABLED=true
# SEMANTIC_CACHE_COLLECTION=semantic_cache
# Cosine similarity of standalone-question embeddings for a cache candidate; the fast model
# then confirms both questions share one answer (one call). At or above the exact threshold
# a candidate hits with no call. Tune with `python -m evaluation.cache_threshold --verify`.
SEMANTIC_CACHE_THRESHOLD=0.80
# SEMANTIC_CACHE_EXACT_THRESHOLD=0.99
# SEMANTIC_CACHE_TTL_SECONDS=86400
# SEMANTIC_CACHE_MAX_ENTRIES=500  # per index version + filter scope

# --- Chunking (counted in the embedding model's own tokens) ---
CHUNK_MIN_TOKENS=100
CHUNK_MAX_TOKENS=512      # must be <= EMBEDDING_MAX_TOKENS
CHUNK_OVERLAP_TOKENS=50

# --- BM25 sparse vectors (after changing these, run `python -m pipeline.reindex_sparse`) ---
# BM25_K1=1.2
# BM25_B=0.75
# BM25_AVG_DOC_LENGTH=256

# --- Guardrails ---
# INPUT_MIN_CHARS=3

# --- Query log (defaults are under the repo root) ---
# QUERY_LOG_PATH=data/query_log.jsonl
# QUERY_LOG_MAX_BYTES=10000000
# QUERY_LOG_BACKUP_COUNT=5

# --- API runtime ---
# POST /api/ingest only reads PDFs inside this folder.
# INGEST_BOOKS_DIR=books
# WARM_MODELS_ON_STARTUP=true
# HEALTH_TIMEOUT_SECONDS=5
