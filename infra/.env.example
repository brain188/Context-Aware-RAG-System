# Configuration contract for app/config.py. Copy to infra/.env and fill in secrets.
# Every Settings field is listed. Lines starting with "# KEY=" show a default you can
# usually leave alone. tests/test_config.py fails if this file and Settings drift apart.
# Leave a value empty only without an inline comment: dotenv keeps the comment as the value.

# --- App ---
ENVIRONMENT=dev           # dev | prod (prod hides 5xx error details)
LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR

# --- Vector store (Qdrant >= 1.16) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_chunks
# Blank for local Qdrant; required for Qdrant Cloud.
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=60
# Points per upsert request (~20 KB each); lower it if ingest uploads time out.
# QDRANT_UPSERT_BATCH_SIZE=16
# Changing a vector name requires recreating the collection and re-ingesting.
# QDRANT_DENSE_VECTOR_NAME=dense
# QDRANT_SPARSE_VECTOR_NAME=bm25

# --- Embedding model ---
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSION=768   # must match the model: bge-base 768, bge-large 1024
# EMBEDDING_MAX_TOKENS=512
# EMBEDDING_QUERY_INSTRUCTION=Represent this sentence for searching relevant passages:

# --- Reranker model ---
RERANKER_MODEL=BAAI/bge-reranker-base
# RERANK_BATCH_SIZE=16

# --- LLM ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY=sk-ant-your-key-here   # REQUIRED; startup fails without it
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2
# LLM_REWRITE_MAX_TOKENS=200
# LLM_GRADER_MAX_TOKENS=300
# Template set in app/prompts/templates/<version>/; part of the cache key.
# PROMPT_VERSION=v1

# --- Redis (sessions + semantic cache) ---
REDIS_URL=redis://localhost:6379
REDIS_TTL_SECONDS=3600    # conversation session expiry
# CONVERSATION_MAX_TURNS=6

# --- Retrieval ---
RETRIEVAL_TOP_K=20        # fused candidates fetched before reranking
RERANK_TOP_K=5            # chunks passed to the LLM after reranking
# RRF_K=60
# Top rerank score below which retrieval grades "none" without an LLM call; tune on the eval set.
# GRADE_MIN_RERANK_SCORE=0.05

# --- Semantic cache ---
# SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.92   # cosine similarity of query embeddings for a hit
# SEMANTIC_CACHE_TTL_SECONDS=86400
# SEMANTIC_CACHE_MAX_ENTRIES=500

# --- Chunking (counted in the embedding model's own tokens) ---
CHUNK_MIN_TOKENS=100
CHUNK_MAX_TOKENS=512      # must be <= EMBEDDING_MAX_TOKENS
CHUNK_OVERLAP_TOKENS=50

# --- BM25 sparse vectors (changing these requires re-ingesting) ---
# BM25_K1=1.2
# BM25_B=0.75
# BM25_AVG_DOC_LENGTH=256

# --- Guardrails ---
# INPUT_MIN_CHARS=3

# --- Query log (defaults are under the repo root) ---
# QUERY_LOG_PATH=data/query_log.jsonl
# QUERY_LOG_MAX_BYTES=10000000
# QUERY_LOG_BACKUP_COUNT=5

# --- API runtime ---
# POST /api/ingest only reads PDFs inside this folder.
# INGEST_BOOKS_DIR=books
# WARM_MODELS_ON_STARTUP=true
# HEALTH_TIMEOUT_SECONDS=5
